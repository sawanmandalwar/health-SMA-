# Copy this file to .env and fill in your own values.
# Never commit .env to source control.

# Backend base URL used by the mobile app.
# - Local testing over the same Wi-Fi: EXPO_PUBLIC_API_URL=http://<your-PC-LAN-IP>:5000
#   (bluetooth/hotspot tip: run `ipconfig` to find the PC's IPv4 address)
# - Or your own tunnel/domain:       EXPO_PUBLIC_API_URL=https://your-host
EXPO_PUBLIC_API_URL=http://localhost:5000
