# Copy this file to Backend/.env and fill in your own values.
# Never commit Backend/.env to source control.

# MongoDB Atlas connection string.
MONGO_URI=

# Port the Express server listens on.
PORT=5000

# Secret used to sign JWTs (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))").
JWT_SECRET=

# Hospital search uses the public OpenStreetMap Overpass API (no key needed).
# Optional: override the Overpass endpoint (defaults to overpass-api.de).
# OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Email provider for caregiver alerts: disabled | gmail | resend | mock
EMAIL_PROVIDER=disabled

# Gmail configuration (required when EMAIL_PROVIDER=gmail)
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=

# Optional tuning (defaults shown)
# MISSED_DOSE_SCHEDULER_ENABLED=false disables automated missed-dose sweeps
# MISSED_DOSE_CHECK_INTERVAL_MS=300000
# MISSED_DOSE_GRACE_MINUTES=60   # auto-missed doses wait this long after the scheduled time
# CAREGIVER_ALERT_THRESHOLD=2
# CAREGIVER_EMAIL_MAX_ATTEMPTS=3
